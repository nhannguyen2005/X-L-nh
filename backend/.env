APP_NAME=TrafficSign AI
ENVIRONMENT=development
LOG_LEVEL=INFO

MODEL_PATH=weights/best.pt
MODEL_VERSION=yolov8n-signs-v1.0
DATASET_VERSION=vietnam-traffic-signs-v1.0
DEVICE=cpu
IMAGE_SIZE=640
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
VERIFICATION_THRESHOLD=0.5
MIN_CLIENT_CONFIDENCE=0.05
MAX_CLIENT_CONFIDENCE=0.95
MAX_DETECTIONS=50
PREPROCESS_CLAHE=false

MAX_UPLOAD_MB=10

DATABASE_URL=sqlite:///data/app.db
CATALOG_PATH=data/signs_catalog.csv
CATALOG_AUTO_SEED=true
HISTORY_ENABLED=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
